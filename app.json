{
  "expo": {
    "name": "EasyNFC",
    "slug": "EasyNFC",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F3",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#102E22",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que a EasyNFC use a câmara para ler códigos QR.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Permitir que a EasyNFC leia e grave autocolantes NFC."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#205A43",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.NFC"
      ],
      "package": "com.mourinho23.easynfc"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
